# 内部测试访问配置（服务端专用，不会下发到前端）
# 进入 /exam 内部测试区域所需的访问密码
NITRO_INTERNAL_TEST_PASSWORD=yunshu
# 签发内部访问凭证的 HMAC 签名密钥（生产环境必设，建议使用随机长字符串）
NITRO_INTERNAL_SECRET=change-me-to-a-random-secret

# ClouderyApi 地址（内部试卷数据源 / 后台管理，前端直连）
# 开发环境：https://localhost:7288（需在浏览器信任开发证书）；生产填正式域名并确保 ClouderyApi 的 CORS 放行本项目站点
NUXT_PUBLIC_CLOUDERY_API_BASE=https://localhost:7288

